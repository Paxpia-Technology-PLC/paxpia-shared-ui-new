{
  "name": "@paxpia/ui",
  "version": "0.1.0",
  "description": "Paxpia's cross-platform view layer — React Native primitives (View/Text/Pressable/Image + StyleSheet) authored ONCE and rendered on web via react-native-web and on mobile via React Native. The view-layer analog of @paxpia/core.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./theme": "./src/theme/index.ts",
    "./overlay": "./src/overlay/index.ts",
    "./gate": "./src/gate/index.ts",
    "./gift": "./src/gift/index.ts",
    "./social": "./src/social/index.ts",
    "./charts": "./src/charts/index.ts",
    "./messaging": "./src/messaging/index.ts",
    "./search": "./src/search/index.ts",
    "./feed": "./src/feed/index.ts",
    "./book": "./src/book/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "recharts": "^2.12.7"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "recharts": "^2.12.7",
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED",
  "private": true
}
